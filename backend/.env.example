# ============================================================
# TRAFFIC ROUTE OPTIMIZER - PRODUCTION CONFIGURATION
# ============================================================
# All API keys below have FREE tiers sufficient for development
# and small-scale production use.
#
# 1. OpenWeatherMap (Weather Data)
#    Sign up: https://openweathermap.org/api
#    Free tier: 1,000 calls/day
#    Get key from: Account > My API Keys
#
# 2. TomTom (Traffic Data)
#    Sign up: https://developer.tomtom.com
#    Free tier: 2,500 transactions/day
#    Get key from: Dashboard > Apps > Create App
#
# 3. OpenRouteService (Route Directions)
#    Sign up: https://openrouteservice.org/dev/#/login
#    Free tier: 2,000 directions/day
#    Get key from: Dashboard > API Keys
#
# 4. Redis (Optional - for caching)
#    Install locally or use Redis Cloud free tier
#    https://redis.io/try-free/
# ============================================================

# === REQUIRED: API Keys ===
OPENWEATHER_API_KEY=your_openweather_api_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
OPENROUTE_API_KEY=your_openroute_api_key_here

# === OPTIONAL: Redis Caching ===
REDIS_URL=redis://localhost:6379/0

# === App Settings ===
APP_NAME=Traffic Route Optimizer
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
